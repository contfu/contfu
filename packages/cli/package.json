{
  "name": "@contfu/cli",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contfu/contfu.git"
  },
  "bin": {
    "contfu": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "pack": "bun ../../scripts/pack-package.ts .",
    "build": "bun build src/main.ts --outdir dist --target node --minify",
    "contfu": "bun src/main.ts",
    "test": "bun test src/commands/login.spec.ts && bun test $(find src -name '*.spec.ts' ! -path 'src/commands/login.spec.ts')"
  },
  "dependencies": {
    "@contfu/svc-api": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
