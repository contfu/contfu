{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "bun"],
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/app.d.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "vite.config.js",
    "vite.config.ts"
  ],
  "exclude": ["node_modules/**", "test/**", "tests/**", "build/**", "dist/**", "src/**/*.spec.ts"]
}
