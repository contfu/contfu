{
  "name": "@contfu/ui",
  "version": "0.1.4",
  "description": "Contfu Server query UI for a Local Store",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contfu/contfu.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun kill; bun -b vite dev",
    "build": "rm -rf build .svelte-kit/output && bun -b vite build",
    "pack": "bun pm pack",
    "preview": "bun kill; bun build/index.js",
    "kill": "lsof -ti :8013 | xargs kill -9",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json",
    "test": "bun test --preload ./test/aliases.ts src/",
    "serve": "bun build/index.js",
    "clean": "rm -rf dist build .svelte-kit",
    "shadcn": "bunx shadcn-svelte"
  },
  "dependencies": {},
  "devDependencies": {
    "@contfu/contfu": "workspace:^0.1.3",
    "@contfu/core": "workspace:^0.1.1",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^0.577.0",
    "@m4k/common": "^0.2.7",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/table-core": "^8.21.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.1",
    "autoprefixer": "^10.5.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "1.0.0-rc.3",
    "drizzle-orm": "1.0.0-rc.3",
    "mode-watcher": "^1.1.0",
    "postcss": "^8.5.15",
    "svelte": "^5.56.3",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "ts-essentials": "^10.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "valibot": "^1.4.1",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "typescript": "^5.6.3"
  },
  "optionalDependencies": {},
  "link": "isolated"
}
