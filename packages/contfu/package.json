{
  "name": "@contfu/contfu",
  "version": "0.3.4",
  "description": "Contfu runtime and local store library for Contfu-powered applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contfu/contfu.git"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.bun.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/index.node.ts",
      "default": "./src/index.node.ts"
    },
    "./shared": {
      "types": "./src/index.shared.ts",
      "default": "./src/index.shared.ts"
    },
    "./src/*": "./src/*"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "bun": "./dist/index.bun.js",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "./shared": {
        "types": "./dist/index.shared.d.ts",
        "default": "./dist/index.shared.js"
      },
      "./dist/*": "./dist/*"
    }
  },
  "scripts": {
    "test": "DATABASE_URL=:memory: bun test src/",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:generate": "rm -rf db/migrations && drizzle-kit generate --name init && bun run ./scripts/generate-js-migrations.ts",
    "build:lib": "tsc -b",
    "build:esm": "bun ../../scripts/rewrite-relative-esm-imports.ts ./dist",
    "pack": "bun ../../scripts/pack-package.ts .",
    "build": "bun run build:lib && bun run build:esm"
  },
  "dependencies": {
    "@contfu/connect": "workspace:^0.1.5",
    "@contfu/core": "workspace:^0.4.0",
    "drizzle-orm": "1.0.0-rc.3"
  },
  "devDependencies": {
    "@m4k/common": "^0.2.8",
    "@types/bun": "^1.4.0",
    "drizzle-kit": "1.0.0-rc.3",
    "ts-essentials": "^10.2.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@contfu/bun-file-store": "workspace:^0.1.7",
    "@contfu/media-optimizer": "workspace:^0.1.7",
    "@contfu/media-optimizer-remote": "workspace:^0.1.7"
  }
}
