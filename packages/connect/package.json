{
  "name": "@contfu/connect",
  "version": "0.1.6",
  "description": "Connector for receiving Sync Messages from Contfu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contfu/contfu.git"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "bun test src/",
    "pack": "bun ../../scripts/pack-package.ts .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@contfu/core": "workspace:^0.3.0",
    "msgpackr": "^1.12.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "ts-essentials": "^10.2.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "eventsource": "^4.1.0"
  }
}
