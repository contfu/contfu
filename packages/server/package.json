{
  "name": "@contfu/server",
  "version": "0.1.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contfu/contfu.git"
  },
  "bin": {
    "contfu-server": "./src/bin.ts"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "bin": {
      "contfu-server": "./dist/bin.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "bun": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "bun kill && bun --watch run src/bin.ts",
    "kill": "lsof -ti :8012 | xargs kill -9",
    "pack": "bun ../../scripts/pack-package.ts .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@contfu/contfu": "workspace:^0.2.0",
    "@contfu/core": "workspace:^0.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@contfu/bun-file-store": "workspace:^0.1.4",
    "@contfu/media-optimizer": "workspace:^0.1.4",
    "@contfu/media-optimizer-remote": "workspace:^0.1.4"
  }
}
