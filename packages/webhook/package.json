{
  "name": "@contfu/webhook",
  "version": "0.2.1",
  "description": "TypeScript client for sending signed Contfu source pushes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contfu/contfu.git"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "bun test src/",
    "pack": "bun ../../scripts/pack-package.ts .",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
