{
  "name": "@contfu/bun-file-store",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contfu/contfu.git"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "bun test src/",
    "build": "tsc -b",
    "pack": "bun ../../../scripts/pack-package.ts .",
    "clean": "rm -rf dist .tmp"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@contfu/contfu": "workspace:^0.1.2",
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
