{
  "name": "@contfu/media-optimizer",
  "version": "0.1.6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contfu/contfu.git"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "bun test src/",
    "build": "tsc -b",
    "pack": "bun ../../../scripts/pack-package.ts .",
    "clean": "rm -rf dist .tmp"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@m4k/common": "^0.2.7",
    "m4k": "^0.3.3",
    "sharp": "^0.34.5",
    "tasque": "^0.1.2"
  },
  "devDependencies": {
    "@contfu/bun-file-store": "workspace:^0.1.6",
    "@contfu/contfu": "workspace:^0.2.2",
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
