{
  "name": "@contfu/media-optimizer-remote",
  "version": "0.1.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contfu/contfu.git"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "bun test src/",
    "build": "tsc -b",
    "pack": "bun ../../../scripts/pack-package.ts .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@m4k/client": "^0.2.10",
    "@m4k/common": "^0.2.8"
  },
  "devDependencies": {
    "@contfu/contfu": "workspace:^0.3.0",
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
