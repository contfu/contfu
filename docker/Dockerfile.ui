FROM oven/bun:1.4.1-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libcap2 libssl3t64 openssl-provider-legacy wget && rm -rf /var/lib/apt/lists/*

FROM base AS build
COPY . .
COPY scripts/retry-timeout.sh scripts/
RUN --mount=type=cache,target=/root/.bun/install/cache ./scripts/retry-timeout.sh --timeout 60 --retries 3 -- bun install --frozen-lockfile --ignore-scripts
RUN bun run -F '@contfu/ui' build

FROM base AS deps
WORKDIR /app
COPY . .
COPY scripts/retry-timeout.sh scripts/
RUN --mount=type=cache,target=/root/.bun/install/cache \
  ./scripts/retry-timeout.sh --timeout 60 --retries 3 -- bun install --frozen-lockfile --ignore-scripts --production --linker=hoisted

FROM base AS app
WORKDIR /app
COPY --from=deps /app/node_modules/ /app/node_modules/
COPY --from=build /app/packages/ui/build/ /app/build/
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --spider -q http://localhost:3000/ || exit 1
CMD ["bun", "run", "./build/index.js"]
